# Kernel-card checkpoint: exact installed619F ADSP firmware is loaded into
# RAM through PIL. No firmware partition or speaker amplifier is programmed.
# Same maintained MSM8937 start trigger; keep modem/CDSP/other cores disabled.
on init
    setprop vendor.amp.init false

on early-boot
    write /sys/kernel/boot_adsp/boot 1
