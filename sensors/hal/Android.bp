cc_binary {
    name: "android.hardware.sensors@1.0-service.ple",
    stem: "android.hardware.sensors@1.0-service",
    overrides: ["android.hardware.sensors@1.0-service"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.sensors@1.0-service.rc"],
    srcs: ["service.cpp"],
    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libhidlbase",
        "android.hardware.sensors@1.0",
    ],
}
