# Exact619F legacy two-process/one-modem DSDS route. Never start qcrild too.
# The source loader links its HIDL ABI bridge and checks it before RIL_Init.
on post-fs-data
    # Exact619F DSDS IPC. This is a socket directory, not a qmuxd service.
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    restorecon /dev/socket/qmux_radio
    mkdir /data/vendor/radio 0770 system radio
    restorecon /data/vendor/radio
    write /data/vendor/radio/copy_complete 0
    chown radio radio /data/vendor/radio/copy_complete
    chmod 0660 /data/vendor/radio/copy_complete
    copy /vendor/radio/qcril_database/qcril.db /data/vendor/radio/qcril_prebuilt.db
    chown radio radio /data/vendor/radio/qcril_prebuilt.db
    chmod 0660 /data/vendor/radio/qcril_prebuilt.db
    restorecon /data/vendor/radio/qcril_prebuilt.db
    write /data/vendor/radio/prebuilt_db_support 1
    chown radio radio /data/vendor/radio/prebuilt_db_support
    chmod 0400 /data/vendor/radio/prebuilt_db_support
    write /data/vendor/radio/db_check_done 0
    chown radio radio /data/vendor/radio/db_check_done
    chmod 0660 /data/vendor/radio/db_check_done
    mkdir /data/vendor/modem_config 0570 radio root
    mkdir /data/vendor/fih_mcfg 02775 system 2901
    mkdir /data/vendor/fih_atl 0776 system 2901
    mkdir /data/vendor/fih_atl/modem_config 0776 system 2901
    restorecon_recursive /data/vendor/modem_config
    restorecon_recursive /data/vendor/fih_mcfg
    restorecon_recursive /data/vendor/fih_atl
    # Cache verification must not block the global init queue and graphics.
    # Keep native RIL disabled until this producer publishes genuine readiness.
    start vendor.ple-radio-mcfg

on property:ro.vendor.ril.mbn_copy_completed=1
    write /data/vendor/radio/copy_complete 1
    # enable preserves class-main ordering even if preparation finishes early.
    enable vendor.ril-daemon
    enable vendor.ril-daemon2

service vendor.ple-radio-mcfg /vendor/bin/init.PLE.radio-mcfg.sh
    disabled
    oneshot
    user root
    group root system radio 2901
    capabilities CHOWN FOWNER

service vendor.ril-daemon /vendor/bin/hw/rild.ple -l /vendor/lib64/libril-qc-qmi-1.so -- -d /dev/smd0
    override
    class main
    disabled
    user radio
    group radio cache inet misc audio log readproc wakelock 2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

service vendor.ril-daemon2 /vendor/bin/hw/rild.ple -l /vendor/lib64/libril-qc-qmi-1.so -c 2 -- -d /dev/smd0
    class main
    disabled
    user radio
    group radio cache inet misc audio log readproc wakelock 2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
