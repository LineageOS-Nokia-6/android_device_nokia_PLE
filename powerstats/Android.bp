// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.power.stats-service.ple",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["main.cpp"],
    shared_libs: ["libbase", "libbinder_ndk", "android.hardware.power.stats-V2-ndk"],
    init_rc: ["android.hardware.power.stats-service.ple.rc"],
    vintf_fragments: ["android.hardware.power.stats-service.ple.xml"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "ple-powerstats-check",
    vendor: true,
    installable: false,
    srcs: ["check.cpp"],
    shared_libs: ["libbinder_ndk", "android.hardware.power.stats-V2-ndk"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
