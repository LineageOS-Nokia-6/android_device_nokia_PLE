    name: "android.hardware.vibrator-service.legacy.ple",
    stem: "android.hardware.vibrator-service.legacy",
    overrides: ["android.hardware.vibrator-service.legacy"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.legacy.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.legacy.xml"],
