        "Vibrator.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhardware",
        "liblog",
        "android.hardware.vibrator-V2-ndk",
    ],
    vendor: true,
}
