prebuilt_etc {
    name: "fstab.qcom",
    src: "rootdir/etc/fstab.qcom",
    vendor: true,
    ramdisk_available: true,
}

prebuilt_etc {
    name: "init.PLE.rc",
    src: "rootdir/etc/init.PLE.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "rootdir/etc/ueventd.qcom.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "recovery/root/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}
