@@ -4,6 +4,20 @@
 #include <telephony/ril.h>
 
 namespace ple_stock_abi {
+// Exact619F64B signal record has two extra GW words at8..15. Stock
+// qcril_log_print_RIL_SignalStrength (29ff08) identifies CDMA16/20,
+// EVDO24/28/32, LTE36..56, TD60. Do not truncate the first56 bytes:
+// that would shift every field after GSM. Preserve standard public ABI.
+inline bool normalizeSignalStrength(const void* response, size_t length,
+                                    RIL_SignalStrength_v10& out) {
+    static_assert(sizeof(RIL_SignalStrength_v10)==56);
+    if (!response || length!=64) return false;
+    const auto* raw=static_cast<const unsigned char*>(response);
+    std::memcpy(&out,raw,8);
+    std::memcpy(reinterpret_cast<unsigned char*>(&out)+8,raw+16,48);
+    return true;
+}
+
