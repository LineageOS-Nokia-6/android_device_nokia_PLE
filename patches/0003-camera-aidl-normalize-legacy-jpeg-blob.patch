diff --git a/camera/aidl/device/LegacyCameraBlob.h b/camera/aidl/device/LegacyCameraBlob.h
new file mode 100644
index 0000000..fa65872
--- /dev/null
+++ b/camera/aidl/device/LegacyCameraBlob.h
@@ -0,0 +1,47 @@
+// Copyright (C) 2026 The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <cerrno>
+#include <poll.h>
+
+namespace android::hardware::camera::device::implementation {
+
+// Borrow the HAL fence, without dup(): descriptor exhaustion must not be
+// mistaken for the valid "no fence" sentinel. Ownership stays with caller.
+inline bool waitForLegacyJpegFence(int fd, int timeoutMs = 1000) {
+    if (fd == -1) return true;
+    if (fd < 0) return false;
+    pollfd descriptor{fd, POLLIN, 0};
+    int result;
+    do { result = poll(&descriptor, 1, timeoutMs); } while (result < 0 && errno == EINTR);
+    return result > 0 && (descriptor.revents & POLLIN) &&
+           !(descriptor.revents & (POLLERR | POLLNVAL));
+}
+
+inline bool legacyJpegPublicationSucceeded(bool contentsValid, int unlockStatus) {
+    return contentsValid && unlockStatus == 0;
+}
+
+// camera3_jpeg_blob_t has uint16_t id + two unspecified padding bytes.
+// AIDL CameraBlob instead has an int32 id at the same offset. Never pass
+// legacy padding to ImageReader as the upper half of that id.
+inline bool normalizeLegacyJpegBlob(void* data, size_t capacity) {
+    if (data == nullptr || capacity < 8) return false;
+    auto* footer = static_cast<uint8_t*>(data) + capacity - 8;
+    uint16_t oldId;
+    uint32_t length;
+    std::memcpy(&oldId, footer, sizeof(oldId));
+    std::memcpy(&length, footer + 4, sizeof(length));
+    if (oldId != 0x00ff || length == 0 || length > capacity - 8 ||
+        length > static_cast<uint32_t>(std::numeric_limits<int32_t>::max())) return false;
+    const uint32_t newId = oldId;
+    std::memcpy(footer, &newId, sizeof(newId));
+    return true;
+}
+
+}  // namespace android::hardware::camera::device::implementation
