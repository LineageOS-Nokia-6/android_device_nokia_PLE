+++ b/libril/ple_stock_abi.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <cstring>
+#include <telephony/ril.h>
+
+namespace ple_stock_abi {
+// Exact619F arm64 libril validates544B: header24, eight64B application
+// records, hotswap at536. The standard fields occupy the first44B of each
+// application; four FIH retry counters and hotswap have no standard HIDL field.
+// Never reinterpret the64B stride as standard48B or relax the existing parser.
+inline bool normalizeCardStatus(const void* response, size_t length,
+                                RIL_CardStatus_v6& out) {
+#if defined(__LP64__)
+    static_assert(sizeof(RIL_CardStatus_v6)==408 && sizeof(RIL_AppStatus)==48);
+    if (!response || length!=544) return false;
+    const auto* raw=static_cast<const unsigned char*>(response);
+    int count;
+    std::memcpy(&count,raw+20,sizeof(count));
+    if (count<0 || count>RIL_CARD_MAX_APPS) return false;
+    std::memset(&out,0,sizeof(out));
+    std::memcpy(&out,raw,24);
+    for (int i=0;i<count;++i) {
+        std::memcpy(&out.applications[i],raw+24+i*64,44);
+    }
+    return true;
+#else
+    (void)response;(void)length;(void)out;
+    return false;
+#endif
+}
+}

