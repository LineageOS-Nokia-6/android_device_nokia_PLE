 /** The helper class that provides methods for adding styles to transition animations. */
 public class TransitionAnimationHelper {
+    // Android15/AOSP edge-surface path, scoped to this proven PLE product.
+    static boolean maybeExtendWindowLegacy(TransitionInfo.Change change, Animation animation,
+            int mode, SurfaceControl.Transaction startTransaction,
+            SurfaceControl.Transaction finishTransaction,
+            java.util.List<java.util.function.Consumer<SurfaceControl.Transaction>> callbacks) {
+        if (!"PLE".equals(android.os.Build.DEVICE) || !"Nokia".equals(android.os.Build.BRAND)) {
+            return false;
+        }
+        if (TransitionUtil.isOpeningType(mode)) {
+            callbacks.add(t -> edgeExtendWindowLegacy(change, animation, t, finishTransaction));
+        } else {
+            edgeExtendWindowLegacy(change, animation, startTransaction, finishTransaction);
+        }
+        return true;
+    }
+
+    static void applyLegacyPostStartCallbacks(SurfaceControl.Transaction startTransaction,
+            java.util.List<java.util.function.Consumer<SurfaceControl.Transaction>> callbacks) {
+        if (!callbacks.isEmpty()) {
+            // Opening content must exist before capture, as in the Android15 path.
+            startTransaction.apply(true /* sync */);
+            for (java.util.function.Consumer<SurfaceControl.Transaction> callback : callbacks) {
+                callback.accept(startTransaction);
+            }
+        }
+    }
+
+    private static void edgeExtendWindowLegacy(TransitionInfo.Change change, Animation animation,
+            SurfaceControl.Transaction startTransaction,
+            SurfaceControl.Transaction finishTransaction) {
+        if ((change.getFlags() & FLAG_STARTING_WINDOW_TRANSFER_RECIPIENT) != 0) {
+            return;
+        }
+        final int height = Math.max(change.getStartAbsBounds().height(),
+                change.getEndAbsBounds().height());
+        final int width = Math.max(change.getStartAbsBounds().width(),
+                change.getEndAbsBounds().width());
+        if (width <= 0 || height <= 0) {
+            return;
+        }
+        final Transformation atStart = new Transformation();
+        final Transformation atEnd = new Transformation();
+        animation.getTransformationAt(0, atStart);
+        animation.getTransformationAt(1, atEnd);
+        final Insets insets = Insets.min(atStart.getInsets(), atEnd.getInsets());
+        if (insets.left < 0) {
+            createExtensionSurfaceLegacy(change.getLeash(), new Rect(0, 0, 1, height),
+                    new Rect(0, 0, -insets.left, height), insets.left, 0,
+                    "PLE Left Edge Extension", startTransaction, finishTransaction);
+        }
+        if (insets.top < 0) {
+            createExtensionSurfaceLegacy(change.getLeash(), new Rect(0, 0, width, 1),
+                    new Rect(0, 0, width, -insets.top), 0, insets.top,
+                    "PLE Top Edge Extension", startTransaction, finishTransaction);
+        }
+        if (insets.right < 0) {
+            createExtensionSurfaceLegacy(change.getLeash(),
+                    new Rect(width - 1, 0, width, height),
+                    new Rect(0, 0, -insets.right, height), width, 0,
+                    "PLE Right Edge Extension", startTransaction, finishTransaction);
+        }
+        if (insets.bottom < 0) {
+            createExtensionSurfaceLegacy(change.getLeash(),
+                    new Rect(0, height - 1, width, height),
+                    new Rect(0, 0, width, -insets.bottom), insets.left, height,
+                    "PLE Bottom Edge Extension", startTransaction, finishTransaction);
+        }
+    }
+
+    private static SurfaceControl createExtensionSurfaceLegacy(SurfaceControl parent,
+            Rect edgeBounds, Rect extensionRect, int x, int y, String name,
+            SurfaceControl.Transaction startTransaction,
+            SurfaceControl.Transaction finishTransaction) {
+        final ScreenCaptureInternal.ScreenshotHardwareBuffer edgeBuffer;
+        final Bitmap bitmap;
+        try {
+            final ScreenCaptureInternal.LayerCaptureArgs captureArgs =
+                    new ScreenCaptureInternal.LayerCaptureArgs.Builder(parent)
+                            .setSourceCrop(edgeBounds)
+                            .setFrameScale(1)
+                            .setPixelFormat(PixelFormat.RGBA_8888)
+                            .setChildrenOnly(true)
+                            .setProtectedContentPolicy(ScreenCapture.ScreenCaptureParams
+                                    .PROTECTED_CONTENT_POLICY_REDACT)
+                            .setSecureContentPolicy(ScreenCapture.ScreenCaptureParams
+                                    .SECURE_CONTENT_POLICY_CAPTURE)
+                            .setPreserveDisplayColors(true)
+                            .build();
+            edgeBuffer = ScreenCaptureInternal.captureLayers(captureArgs);
+            bitmap = edgeBuffer == null ? null : edgeBuffer.asBitmap();
+        } catch (RuntimeException error) {
+            android.util.Log.w("PLETransition", "Edge capture unavailable", error);
+            return null;
+        }
+        if (bitmap == null) {
+            // Unlike the old helper, allocate no layer when capture is unavailable.
+            return null;
+        }
+        final SurfaceControl edgeLayer;
+        try {
+            edgeLayer = new SurfaceControl.Builder()
+                    .setName(name)
+                    .setParent(parent)
+                    .setHidden(true)
+                    .setCallsite("TransitionAnimationHelper#createExtensionSurfaceLegacy")
+                    .setOpaque(true)
+                    .setSecure(edgeBuffer.containsSecureLayers())
+                    .setBufferSize(extensionRect.width(), extensionRect.height())
+                    .build();
+        } catch (RuntimeException error) {
+            android.util.Log.w("PLETransition", "Edge layer unavailable", error);
+            return null;
+        }
+        Surface surface = null;
+        try {
+            final BitmapShader shader = new BitmapShader(bitmap,
+                    Shader.TileMode.CLAMP, Shader.TileMode.CLAMP);
+            final Paint paint = new Paint();
+            paint.setShader(shader);
+            surface = new Surface(edgeLayer);
+            final Canvas canvas = surface.lockHardwareCanvas();
+            canvas.drawRect(extensionRect, paint);
+            surface.unlockCanvasAndPost(canvas);
+        } catch (RuntimeException error) {
+            startTransaction.remove(edgeLayer);
+            edgeLayer.release();
+            android.util.Log.w("PLETransition", "Edge rendering unavailable", error);
+            return null;
+        } finally {
+            if (surface != null) {
+                surface.release();
+            }
+        }
+        startTransaction.setLayer(edgeLayer, Integer.MIN_VALUE);
+        startTransaction.setPosition(edgeLayer, x, y);
+        startTransaction.setVisibility(edgeLayer, true);
+        finishTransaction.remove(edgeLayer);
+        return edgeLayer;
+    }
