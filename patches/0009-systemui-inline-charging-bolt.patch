+internal data class BatteryGlyphRowLayout(val scale: Float, val startX: Float)
+
+/** Fit a glyph row inside the 24-unit body, leaving room for the rounded corners. */
+internal fun batteryGlyphRowLayout(widths: List<Float>): BatteryGlyphRowLayout {
+    val totalWidth = widths.sum() + 0.8f * (widths.size - 1).coerceAtLeast(0)
+    val scale = if (totalWidth > 0f) minOf(1f, 20f / totalWidth) else 1f
+    return BatteryGlyphRowLayout(scale, (24f - totalWidth * scale) / 2f)
+}
