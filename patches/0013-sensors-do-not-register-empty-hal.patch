index 65f6d816a..20ef6d832 100644
--- a/sensors/1.0/default/service.cpp
+++ b/sensors/1.0/default/service.cpp
@@ -20,12 +20,31 @@
 #include <hidl/LegacySupport.h>
 
 using android::hardware::sensors::V1_0::ISensors;
-using android::hardware::defaultPassthroughServiceImplementation;
 
 int main() {
     /* Sensors framework service needs at least two threads.
      * One thread blocks on a "poll"
      * The second thread is needed for all other HAL methods.
      */
-    return defaultPassthroughServiceImplementation<ISensors>(2);
+    android::hardware::configureRpcThreadpool(2, true);
+    auto sensors = ISensors::getService("default", true /* getStub */);
+    if (sensors == nullptr) {
+        ALOGE("Sensor HAL implementation is unavailable");
+        return 1;
+    }
+    size_t count = 0;
+    auto result = sensors->getSensorsList([&](const auto& list) { count = list.size(); });
+    if (!result.isOk() || count == 0) {
+        // SSC may still be starting. Let init retry with a fresh implementation
+        // instead of publishing an empty list cached for the lifetime of Android.
+        ALOGE("Sensor HAL is not ready: %zu sensors; waiting for init retry", count);
+        return 1;
+    }
+    if (sensors->registerAsService("default") != android::OK) {
+        ALOGE("Sensor HAL registration failed");
+        return 1;
+    }
+    ALOGI("Sensor HAL ready: %zu hardware sensors", count);
+    android::hardware::joinRpcThreadpool();
+    return 1;
 }
